# AutoPilot AI — environment configuration example.
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# Variables are introduced incrementally per development milestone.

# --- Application ------------------------------------------------------------
APP_NAME="AutoPilot AI"
APP_VERSION="0.1.0"
# One of: local | development | staging | production
ENVIRONMENT=local
DEBUG=false

# --- API --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Async SQLAlchemy URL. For production use e.g.
#   postgresql+asyncpg://user:pass@host:5432/autopilot
DATABASE_URL=sqlite+aiosqlite:///./autopilot.db
DB_ECHO=false

# --- Calendar -----------------------------------------------------------------
# `local` keeps events in this platform's own database, so scheduling works
# with no external account. `google` selects the adapter seam, which has no
# OAuth flow yet and fails loudly rather than reporting an empty calendar.
CALENDAR_PROVIDER=local        # local | google

# --- Email agent (IMAP in, SMTP out) ------------------------------------------
# Mailbox reading turns on when host + username + password are all set. Sending
# reuses the SMTP_* settings above. Both are optional: without them the Email
# page still loads and sync/send return a clear 502.
# Gmail needs an App Password, not your account password.
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#IMAP_USERNAME=
#IMAP_PASSWORD=
#IMAP_MAILBOX=INBOX
#IMAP_USE_SSL=true

# --- MCP (Model Context Protocol) ---------------------------------------------
# JSON array of MCP servers whose tools are adapted into the tool registry. This
# list IS the allow-list: no other server is ever contacted, and tool output is
# treated as untrusted data. Unset means no external MCP tools.
#   MCP_SERVERS=[{"name":"files","transport":"stdio","command":"mcp-server-filesystem","args":["/data"]}]
#   MCP_SERVERS=[{"name":"remote","transport":"http","url":"https://host/mcp"}]
#MCP_SERVERS=

# AutoPilot also *serves* MCP: point external clients at
#   POST <API_URL>/api/v1/tools/mcp
# to use this instance's native tools over JSON-RPC. No configuration needed.

# --- Workflows ----------------------------------------------------------------
# SQLite file backing LangGraph checkpoints (workflow pause/resume state).
CHECKPOINT_DB_PATH=./workflow_checkpoints.db

# --- Scheduler ----------------------------------------------------------------
# Hour (UTC, 0-23) at which the daily digest job runs.
DIGEST_HOUR=8

# --- Notifications (optional channels; in-app is always on) -------------------
# Telegram: create a bot via @BotFather, then set both values.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# SMTP email: enabled when SMTP_HOST and SMTP_FROM are set.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=

# --- Security ---------------------------------------------------------------
# This platform has NO AUTHENTICATION: it is a single shared workspace, and
# anyone who can reach the API has full access to everything in the instance
# (see docs/COMPLETION_PLAN.md §3). There is nothing to configure here — no
# secret, no token lifetime, no auth rate limit. Do not expose an instance
# holding real business documents to the public internet.

# --- Documents / file storage -------------------------------------------------
# Which implementation backs file storage: `local` (disk) or `s3` (any
# S3-compatible bucket: Cloudflare R2, AWS S3, MinIO). Free PaaS disks are
# ephemeral, so cloud deployments should use `s3` — see
# backend/.env.production.example.
STORAGE_PROVIDER=local
# Base directory for uploaded files when STORAGE_PROVIDER=local (outside the
# webroot). In Docker this is the mounted `documents` volume.
DOCUMENTS_DIR=./documents
MAX_UPLOAD_SIZE_MB=25
# Used only when STORAGE_PROVIDER=s3.
#S3_BUCKET=
#S3_ENDPOINT_URL=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=auto

# --- RAG / ingestion ----------------------------------------------------------
# Character window and overlap used when chunking extracted document text.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- AI providers ---------------------------------------------------------------
# Each port picks its implementation from these three values. The defaults keep
# everything local and free (Ollama + ChromaDB); the cloud trio
# (groq / jina / qdrant) needs no code change — see
# backend/.env.production.example.
LLM_PROVIDER=ollama                 # ollama | groq
EMBEDDING_PROVIDER=ollama           # ollama | jina
VECTOR_STORE_PROVIDER=chroma        # chroma | qdrant

# Local stack. In Docker Compose these point at the in-network services.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=autopilot_documents
# Long-term memory (blueprint §16 level 3) indexes into its OWN collection so
# durable facts can never surface as document search results. Applies to Qdrant
# too, despite the CHROMA_ prefix on its neighbour.
MEMORY_COLLECTION=autopilot_memory

# --- RAG depth (blueprint §17) ------------------------------------------------
# Hybrid retrieval: vector + BM25 keyword, fused with Reciprocal Rank Fusion.
# Set false to fall back to vector-only.
RAG_HYBRID_ENABLED=true
# Cap on the SQL prefilter for keyword candidates (an unindexed LIKE scan).
RAG_KEYWORD_CANDIDATES=200
# Token budget for retrieved context in a grounded answer. Counted with an
# estimator, not a tokenizer.
RAG_CONTEXT_BUDGET_TOKENS=2000
# Candidates handed to the reranker; it returns the best top_k of them.
RERANK_CANDIDATES=20

# Reranking. `none` is a genuine pass-through -- there is no honest local
# cross-encoder, so the stage is simply absent unless configured.
RERANK_PROVIDER=none          # none | jina
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- OCR (scanned documents) ---------------------------------------------------
# Needs the Tesseract binary AND the extra: pip install -e './backend[ocr]'
#   apt-get install tesseract-ocr   /   brew install tesseract
# With OCR on, .png/.jpg uploads are accepted and text-free PDFs fall back to it.
OCR_ENABLED=false
OCR_LANGUAGES=eng

# Vector dimension of the embedding model; sizes the Qdrant collection.
# nomic-embed-text and jina-embeddings-v3 are both 768. Changing the embedding
# model means using a fresh collection name.
EMBEDDING_DIM=768

# Cloud LLM (Groq — OpenAI-compatible, free tier). Used when LLM_PROVIDER=groq.
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.1-8b-instant
#GROQ_BASE_URL=https://api.groq.com/openai/v1

# Cloud embeddings (Jina — free tier). Used when EMBEDDING_PROVIDER=jina.
#JINA_API_KEY=
#JINA_MODEL=jina-embeddings-v3

# Cloud vector store (Qdrant — free tier). Used when VECTOR_STORE_PROVIDER=qdrant.
#QDRANT_URL=
#QDRANT_API_KEY=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# One of: json | console
LOG_FORMAT=json
