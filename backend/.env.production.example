# AutoPilot AI — backend production environment (cloud, free tier).
# Copy the values into your host's environment UI (Render / Hugging Face Space).
# Never commit a filled-in copy of this file.
#
# ⚠ THERE IS NO AUTHENTICATION. Anyone who can reach this URL has full access to
#   every document, conversation, and task in the instance. Do not deploy an
#   instance holding real business data. See docs/COMPLETION_PLAN.md §3.

# --- Application ------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- CORS -------------------------------------------------------------------
# Your deployed frontend origin. Comma-separated for more than one.
CORS_ORIGINS=https://your-app.vercel.app

# --- Database (Neon Postgres) -----------------------------------------------
# Direct endpoint:  postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
# Pooled endpoint:  ...-pooler.HOST/neondb?ssl=require   (statement cache is
#                   disabled automatically for pooled hosts — see engine.py)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require

# --- Provider selection -----------------------------------------------------
# Cloud trio replacing the local Ollama + Chroma stack. No code change: the
# ports in app/domain/interfaces are resolved from these three values.
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=jina
VECTOR_STORE_PROVIDER=qdrant

# --- Cloud LLM (Groq) -------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Cloud embeddings (Jina) ------------------------------------------------
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
# Must match the dimension the Qdrant collection was created with. Changing the
# embedding model means using a fresh collection name.
EMBEDDING_DIM=768

# --- Cloud vector store (Qdrant) --------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
CHROMA_COLLECTION=autopilot_documents
# Long-term memory uses a separate collection from document chunks.
MEMORY_COLLECTION=autopilot_memory

# --- File storage -----------------------------------------------------------
# STORAGE_PROVIDER=local keeps uploads on the container disk, which is EPHEMERAL
# on Render/HF free tiers: file bytes vanish on restart (Postgres rows and
# Qdrant vectors survive, so search keeps working). Use s3 for durability.
STORAGE_PROVIDER=s3
DOCUMENTS_DIR=/data/documents

# S3-compatible object storage (Cloudflare R2 free tier, AWS S3, MinIO, …).
# R2: endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com and region auto.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Workflows --------------------------------------------------------------
# LangGraph checkpoints (approval pause/resume). Also on the ephemeral disk:
# an in-flight approval does not survive a restart.
CHECKPOINT_DB_PATH=/data/workflow_checkpoints.db

# --- Scheduler --------------------------------------------------------------
DIGEST_HOUR=8

# --- Notifications (optional; in-app is always on) --------------------------
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
