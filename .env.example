# AutoPilot AI — environment configuration example.
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# Variables are introduced incrementally per development milestone.

# --- Application ------------------------------------------------------------
APP_NAME="AutoPilot AI"
APP_VERSION="0.1.0"
# One of: local | development | staging | production
ENVIRONMENT=local
DEBUG=false

# --- API --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Async SQLAlchemy URL. For production use e.g.
#   postgresql+asyncpg://user:pass@host:5432/autopilot
DATABASE_URL=sqlite+aiosqlite:///./autopilot.db
DB_ECHO=false

# --- Workflows ----------------------------------------------------------------
# SQLite file backing LangGraph checkpoints (workflow pause/resume state).
CHECKPOINT_DB_PATH=./workflow_checkpoints.db

# --- Scheduler ----------------------------------------------------------------
# Hour (UTC, 0-23) at which the daily digest job runs.
DIGEST_HOUR=8

# --- Notifications (optional channels; in-app is always on) -------------------
# Telegram: create a bot via @BotFather, then set both values.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# SMTP email: enabled when SMTP_HOST and SMTP_FROM are set.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=

# --- Security / JWT ---------------------------------------------------------
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-set-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Per-IP limit on login/register/refresh attempts (sliding 60s window).
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Documents / file storage -------------------------------------------------
# Base directory for uploaded files (outside the webroot). In Docker this is
# the mounted `documents` volume.
DOCUMENTS_DIR=./documents
MAX_UPLOAD_SIZE_MB=25

# --- RAG / ingestion ----------------------------------------------------------
# Character window and overlap used when chunking extracted document text.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- AI providers ---------------------------------------------------------------
# Local Ollama server (embeddings now; LLM in M3) and ChromaDB vector store.
# In Docker Compose these point at the in-network services instead.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=autopilot_documents

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# One of: json | console
LOG_FORMAT=json
